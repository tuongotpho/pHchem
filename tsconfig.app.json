{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    /* Lõi đếm nguyên tử dùng chung với script sinh hình viết bằng .js
       thuần, vì script chạy Node trần không qua bộ dịch nào. */
    "allowJs": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /* Chế độ chặt: bắt buộc khai rõ kiểu, và KHÔNG cho quên rằng một giá trị
       có thể là null/undefined. Bật ngày 24/08/2026 — lúc bật, `tsc --strict`
       báo 0 lỗi, tức mã vốn đã viết đúng, chỉ là chưa có ai gác.
       Giống rơ-le bảo vệ: đấu đúng thì rơ-le nằm im, nhưng thiếu nó thì hôm
       chạm chập mới biết. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
