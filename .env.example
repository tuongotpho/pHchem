# Cấu hình Firebase — CHỈ ĐIỀN KHI MUỐN BẬT ĐỒNG BỘ.
# Hiện app chạy offline không cần các biến này.
# Chép file này thành ".env" rồi điền giá trị từ Firebase Console.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# TikTok Content Posting API — lay o https://developers.tiktok.com/app/
